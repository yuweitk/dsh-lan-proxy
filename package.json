{
  "name": "@wingsky-1/dsh-lan-proxy",
  "version": "0.2.10-fork.1",
  "description": "[fork of @wingsky-1/dsh-lan-proxy@0.2.10] Expose the dsh web UI on the LAN by forwarding HTTP/HTTPS and WebSocket to the loopback server. 局域网访问 dsh web UI：在 0.0.0.0:<port> 监听，把 HTTP/HTTPS 与 WebSocket/wss 转发到回环 web 服务器（默认 127.0.0.1:3080）。重写 Host/Origin 以通过 /api 浏览器信任围栏，仅接受 IP 字面量或 localhost 的 Host 头（DNS 重绑定防护）。HTTPS 默认并存（3443），证书可配置或自动生成自签名。（本 fork 额外重写同源 Referer，修复经 LAN 代理访问时插件同源校验 403）",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "echo '本仓库是 monorepo 的包目录快照，构建请见 README「构建」一节' && exit 1",
    "test": "echo '测试需要上游 monorepo 的 vitest 配置，请见 README「构建」一节' && exit 1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "bannerJs": "import { createRequire as __lanProxyRequire } from \"node:module\";\nconst require = __lanProxyRequire(import.meta.url);"
    },
    "catalog": {
      "category": "integration",
      "summary": {
        "en": "Access the dsh web UI over the LAN: HTTP/HTTPS/WebSocket forwarding to the loopback server with TLS and DNS-rebinding protection.",
        "zh": "局域网访问 dsh web UI：HTTP/HTTPS 与 WebSocket 转发到回环服务，HTTPS 默认并存，DNS 重绑定防护"
      },
      "capabilities": [
        "connection",
        "ui-slots"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "locale",
    "shared/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.upstream.md",
    "README.upstream.en.md",
    "CHANGES-fork.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuweitk/dsh-lan-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/yuweitk/dsh-lan-proxy/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "lan",
    "proxy",
    "tunnel"
  ],
  "author": "wingsky-1",
